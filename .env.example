PORT=3000
NODE_ENV=development

# Authentication PINs — REPLACE BEFORE DEPLOY. The server logs a red warning at startup
# if any super_admin still has one of the well-known defaults (1234, 5678, 9012, etc.).
ADMIN_PIN=CHANGE_ME
JUDGE_PIN=CHANGE_ME
CHAIR_PIN=CHANGE_ME

# Database password — change before first run in any non-throwaway environment.
DB_PASSWORD=CHANGE_ME

# Station agent auth. REQUIRED in production — the server refuses to start if unset.
# Generate with:  openssl rand -hex 32  (or any other random 32+ char string)
# Every station's config.json bakes this in via the admin-only installer download, so
# rotating it means redistributing the installer to each station.
STATION_TOKEN=CHANGE_ME

# --- Electronic voting (Prompt H) ---

# Secret key used to HMAC-hash voter QR-sticker tokens before storing them.
# REQUIRED before generating real stickers. Must stay STABLE — changing it makes
# every already-issued token unverifiable. Generate with:  openssl rand -hex 32
EV_TOKEN_SECRET=CHANGE_ME

# Public base URL the voter QR codes point at — gets baked into printed stickers,
# so set the real domain before printing. Voter URL = <VOTE_BASE_URL>/<event_code>/?t=<token>
VOTE_BASE_URL=http://localhost:3000
